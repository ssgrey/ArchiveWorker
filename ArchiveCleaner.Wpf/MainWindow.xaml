<Window x:Class="ArchiveCleaner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:ArchiveCleaner.Wpf.Models"
        mc:Ignorable="d"
        Title="档案净页" Width="1600" Height="920" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="MainWindow_PreviewKeyDown"
        ToolTipService.InitialShowDelay="300" ToolTipService.BetweenShowDelay="100" ToolTipService.ShowDuration="20000">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SegmentButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" /><Setter Property="MinWidth" Value="80" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#C5CCD1" /><Setter Property="BorderThickness" Value="1,1,0,1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#F2F6F5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsTabStyle" TargetType="TabItem">
            <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="17,0" /><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="0" /><Setter Property="MinWidth" Value="52" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="#3B454B" /></Style>
        <Style x:Key="NumericSettingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Width" Value="58" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
        <Style x:Key="FileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#EDF0F1" /><Setter Property="BorderThickness" Value="3,0,0,1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F4F8F7" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- 图片目录节点颜色：选中（包括失去焦点）和未选中时的鼠标悬停。 -->
        <SolidColorBrush x:Key="CatalogTreeSelectedBackgroundBrush" Color="#87CEFA" />
        <SolidColorBrush x:Key="CatalogTreeHoverBackgroundBrush" Color="#F4F8F7" />
        <Style x:Key="CatalogTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Width="18" Height="20"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8"
                                                  Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="HeaderBorder" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource CatalogTreeHoverBackgroundBrush}" />
                            </Trigger>
                            <!-- 选中优先于悬停，失去键盘焦点后仍保留同一选中颜色。 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#263136" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="24" Height="24" Margin="14,0,10,0" BorderBrush="#73B9AE" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="净" Foreground="#A8DDD5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Grid.Column="1" Text="档案净页" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding BatchName, StringFormat=  ·  {0}}" Foreground="#AEB8BC" VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Grid.Column="3" Content="⚙ 设置" Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="12,0" Height="32" VerticalAlignment="Center" Cursor="Hand"
                        Command="{Binding OpenSettingsCommand}" ToolTip="打开应用设置"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#AEB8BC" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#364349" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化窗口。" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化或还原窗口。" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭程序。未保存的设置方案不会自动写入文件。" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource PrimaryButtonStyle}" Click="StartBatch_Click" IsEnabled="{Binding CanRunSelectedBatch}" AutomationProperties.Name="导出结果" ToolTip="选择输出文件夹后，重新分析并导出左侧已勾选的图片；原文件始终不会被覆盖。"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="导出结果" /></StackPanel></Button></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="AddFiles_Click" ToolTip="选择一张或多张扫描图片加入当前队列。支持 JPG、PNG、TIFF 和 BMP；加入文件不会修改原图。"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,-1,5,0" /><TextBlock Text="添加文件" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Margin="8,0,0,0" Click="OpenFolder_Click" ToolTip="可一次选择多个包含扫描图片的文件夹。程序会递归读取其中的多层图片目录，不会修改或移动源文件。">打开文件夹</Button>
                    <Border Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="12,0" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" IsEnabled="{Binding CanUndoManualEdit}" Click="UndoManualEdit_Click" AutomationProperties.Name="撤销人工修正" ToolTip="撤销当前图片最近一次人工修正（Ctrl+Z）。" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A6;" IsEnabled="{Binding CanRedoManualEdit}" Click="RedoManualEdit_Click" Margin="6,0,0,0" AutomationProperties.Name="重做人工修正" ToolTip="重做当前图片最近一次被撤销的人工修正（Ctrl+Y）。" />
                    <Button Visibility="Collapsed" Margin="8,0,0,0" Click="LoadProfile_Click">加载方案</Button>
                    <Button Visibility="Collapsed" Margin="6,0,0,0" Click="SaveProfile_Click">保存为方案</Button>
                    <Border Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="12,0" />
                    <Button Click="Analyze_Click" IsEnabled="{Binding CanRunSelectedBatch}" ToolTip="分析左侧已勾选的图片，并在分析全部成功后自动批准去除所有未确认黄色区域。操作只生成预览，不会写出图片。">分析选中图片</Button>
                    <Button Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="{Binding CanCancelOperation}" ToolTip="取消正在进行的分析、重新预览、批量确认或导出。已经完整提交的结果会保留。">取消任务</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="286" /><ColumnDefinition Width="*" MinWidth="560" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="112" /></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="13,0"><DockPanel>
                        <Button x:Name="CatalogMenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" BorderThickness="0" Content="&#xE712;" Click="CatalogMenu_Click" AutomationProperties.Name="图片目录更多操作" ToolTip="选择图片、展开目录或从任务队列移除图片。文件夹和文件也可右键移除。">
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem x:Name="SelectAllMenuItem" Header="全选" Click="SelectAllImages_Click" />
                                <MenuItem x:Name="SelectNoneMenuItem" Header="全不选" Click="SelectNoImages_Click" />
                                <Separator />
                                <MenuItem Header="展开全部" Click="ExpandAllFolders_Click" />
                                <MenuItem Header="折叠全部" Click="CollapseAllFolders_Click" />
                                <Separator />
                                <MenuItem x:Name="RemoveCheckedMenuItem" Header="从列表移除已勾选项" Click="RemoveCheckedImages_Click" />
                                <MenuItem x:Name="ClearQueueMenuItem" Header="清空列表" Click="ClearImageQueue_Click" />
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="图片目录" FontWeight="SemiBold" /><TextBlock Text="  " /><TextBlock Text="{Binding DirectoryPositionText}" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                    </DockPanel></Border>
                    <TreeView Grid.Row="1" ItemsSource="{Binding TreeRoots}" BorderThickness="0" Background="White" ItemContainerStyle="{StaticResource CatalogTreeItemStyle}" SelectedItemChanged="CatalogTree_SelectedItemChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:FolderTreeNode}" ItemsSource="{Binding Children}"><DockPanel Height="30" MinWidth="190"><DockPanel.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="移除文件夹" Click="RemoveTreeNode_Click" /></ContextMenu></DockPanel.ContextMenu><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" AutomationProperties.Name="{Binding Name, StringFormat=选择目录 {0}}" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="勾选或取消该目录下的全部图片。" /><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}" Margin="8,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath}" /></DockPanel></HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type models:ImageTreeNode}"><Grid Height="78" MinWidth="205" ToolTip="{Binding Image.FilePath}"><Grid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="ImageTreeContextMenu_Opened"><MenuItem Header="重新分析当前图片" Click="ReanalyzeTreeImage_Click" ToolTip="清除当前图片的人工修改，并按当前设置重新分析。" /><MenuItem Header="恢复成原图" Tag="RestoreOriginal" Click="RestoreTreeImage_Click" ToolTip="恢复当前图片的原始内容，并切换为仅手工处理；可重复执行。" /><Separator /><MenuItem Header="移除文件" Click="RemoveTreeNode_Click" /></ContextMenu></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.Name="{Binding Image.FileName, StringFormat=选择图片 {0}}" VerticalAlignment="Center" ToolTip="控制该图片是否参与批量分析、确认去除和导出。" /><StackPanel Grid.Column="1" Margin="8,8,4,8"><TextBlock Text="{Binding Image.FileName}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Image.DimensionsText}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="7" Height="7" Fill="{Binding Image.StatusBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Image.StatusText}" Foreground="{Binding Image.StatusBrush}" FontSize="11" Margin="5,0,0,0" /></StackPanel></StackPanel></Grid></DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#FAFBFB" Padding="13,12"><StackPanel>
                        <DockPanel><TextBlock Text="任务进度" Foreground="{StaticResource MutedTextBrush}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ProcessedCount, StringFormat={}{0}}" FontWeight="SemiBold" /></DockPanel>
                        <ProgressBar Height="5" Margin="0,10,0,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#DDE2E4" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"><Run Text="已分析 " /><Run Text="{Binding ProcessedCount, Mode=OneWay}" /><Run Text=" 张；" /><Run Text="{Binding ReviewCount, Mode=OneWay}" /><Run Text=" 张需要人工确认" /></TextBlock>
                    </StackPanel></Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#D8DEE0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="PreviewToolbar" Grid.Row="0" MinHeight="48" Padding="12,4" Background="#F8F9F9" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid x:Name="PreviewToolbarLayout" VerticalAlignment="Center" SizeChanged="PreviewToolbarLayout_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel x:Name="PreviewModeTools" Orientation="Horizontal" Height="34" Margin="0,2,16,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="SideBySideModeButton" Style="{StaticResource SegmentButtonStyle}" IsChecked="True" Content="并排" Click="PreviewMode_Click" ToolTip="左侧显示原图和检测掩膜，右侧显示处理预览，滚动位置保持同步。" />
                                <ToggleButton x:Name="CompareModeButton" Style="{StaticResource SegmentButtonStyle}" Content="滑块对比" Click="PreviewMode_Click" ToolTip="在同一位置拖动分隔线比较原图与修复结果。" />
                                <ToggleButton x:Name="MaskOnlyModeButton" Style="{StaticResource SegmentButtonStyle}" BorderThickness="1" Content="仅看掩膜" Click="PreviewMode_Click" ToolTip="隐藏纸张内容，只显示准备删除、受保护、需要确认及人工标记区域。" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="红色表示准备去除，绿色表示内容保护，黄色表示需要人工确认。">
                                <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource DangerBrush}" RadiusX="2" RadiusY="2" />
                                <TextBlock Text="去除" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource ProtectBrush}" RadiusX="2" RadiusY="2" />
                                <TextBlock Text="保护" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource ReviewBrush}" RadiusX="2" RadiusY="2" />
                                <TextBlock Text="确认" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="PreviewZoomTools" Orientation="Horizontal" Height="34" Margin="0,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SegmentButtonStyle}" IsChecked="{Binding Settings.ShowRulers, Mode=TwoWay}" Content="四边刻度" ToolTip="显示或隐藏图片四周的毫米刻度。" />
                            <ToggleButton Style="{StaticResource SegmentButtonStyle}" IsChecked="{Binding Settings.ShowCrosshair, Mode=TwoWay}" BorderThickness="1,1,1,1" Content="十字参考线" ToolTip="显示或隐藏两张图片同步的十字参考线。" Margin="1,0,8,0" />
                            <Button Style="{StaticResource IconButtonStyle}" Click="FitPreview_Click" AutomationProperties.Name="适合窗口" ToolTip="让当前扫描页完整显示在预览区域中。">
                                <Grid Width="16" Height="16">
                                    <Path Data="M 1,6 L 1,1 6,1 M 10,1 L 15,1 15,6 M 15,10 L 15,15 10,15 M 6,15 L 1,15 1,10" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" />
                                    <Rectangle Width="6" Height="8" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                                </Grid>
                            </Button>
                            <TextBlock x:Name="PreviewZoomText" Text="100%" Width="42" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="6,0" />
                            <Slider x:Name="PreviewZoomSlider" Width="92" VerticalAlignment="Center" Minimum="25" Maximum="400" Value="100" SmallChange="5" LargeChange="25" ValueChanged="PreviewZoom_ValueChanged" ToolTip="相对于适合窗口的大小调整预览，范围 25%～400%。" />
                            <Button Style="{StaticResource IconButtonStyle}" Click="ZoomInPreview_Click" Margin="8,0,0,0" AutomationProperties.Name="放大预览" ToolTip="将预览放大 25%。">
                                <Grid Width="16" Height="16">
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" />
                                    <Path Data="M 9,9 L 15,15 M 3,6 L 9,6 M 6,3 L 6,9" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="PreviewContentHost" Grid.Row="1" SizeChanged="PreviewContentHost_SizeChanged" PreviewMouseWheel="PreviewContentHost_PreviewMouseWheel">
                    <Grid x:Name="SideBySidePreviewPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#EEF1F2" Padding="11,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedIndexText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><TextBlock Text="原图与检测掩膜" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border><ScrollViewer x:Name="SideAnalysisScroll" Grid.Row="1" Margin="20" Background="#D6DCDE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollChanged="SidePreviewScrollChanged"><Border x:Name="AnalysisImageFrame" BorderBrush="#40484B" BorderThickness="1" SizeChanged="PreviewFrame_SizeChanged"><Grid><Image x:Name="AnalysisPreviewImage" Source="{Binding SelectedAnalysisPreview}" Stretch="Fill" IsHitTestVisible="False" /><Canvas x:Name="ManualDrawingCanvas" AutomationProperties.Name="人工绘制画布" Background="Transparent" Cursor="Cross" MouseLeftButtonDown="ManualCanvas_MouseLeftButtonDown" MouseMove="ManualCanvas_MouseMove" MouseLeftButtonUp="ManualCanvas_MouseLeftButtonUp" MouseLeave="ManualCanvas_MouseLeave" LostMouseCapture="ManualCanvas_LostMouseCapture"><Ellipse x:Name="BrushCursorEllipse" Visibility="Collapsed" IsHitTestVisible="False" Fill="Transparent" StrokeThickness="1.5" StrokeDashArray="3,2" /></Canvas><Canvas x:Name="AnalysisRulerCanvas" IsHitTestVisible="False" /><Canvas x:Name="AnalysisCandidateGuideCanvas" /></Grid></Border></ScrollViewer></Grid>
                        <Border Grid.Column="1" Background="#EEF1F2" />
                        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#EEF1F2" Padding="11,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="同步缩放与滚动" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><TextBlock Text="处理预览" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border><ScrollViewer x:Name="SideRepairedScroll" Grid.Row="1" Margin="20" Background="#D6DCDE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollChanged="SidePreviewScrollChanged"><Border x:Name="RepairedImageFrame" BorderBrush="#40484B" BorderThickness="1" SizeChanged="PreviewFrame_SizeChanged"><Grid><Image Source="{Binding SelectedRepairedPreview}" Stretch="Fill" IsHitTestVisible="False" /><Canvas x:Name="RepairedRulerCanvas" IsHitTestVisible="False" /><Canvas x:Name="RepairedCandidateGuideCanvas" /></Grid></Border></ScrollViewer></Grid>
                    </Grid>
                    <Grid x:Name="SliderComparePreviewPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#EEF1F2" Padding="11,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="拖动图中分界线" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><TextBlock Text="原图 / 修复结果" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border><ScrollViewer x:Name="CompareScroll" Grid.Row="1" Margin="20" Background="#D6DCDE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><Border x:Name="CompareImageFrame" BorderBrush="#40484B" BorderThickness="1" Cursor="SizeWE" MouseLeftButtonDown="CompareImageFrame_MouseLeftButtonDown" MouseMove="CompareImageFrame_MouseMove" MouseLeftButtonUp="CompareImageFrame_MouseLeftButtonUp" SizeChanged="PreviewContentHost_SizeChanged"><Grid><Image Source="{Binding SelectedPreview}" Stretch="Fill" /><Image Source="{Binding SelectedRepairedPreview}" Stretch="Fill"><Image.Clip><RectangleGeometry x:Name="CompareProcessedClip" /></Image.Clip></Image><Canvas IsHitTestVisible="False"><Rectangle x:Name="CompareDividerLine" Width="2" Fill="White" /><Border x:Name="CompareDividerThumb" Width="28" Height="44" Background="#D9FFFFFF" BorderBrush="#516067" BorderThickness="1" CornerRadius="4"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#334047" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Canvas></Grid></Border></ScrollViewer></Grid>
                    <Grid x:Name="MaskOnlyPreviewPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#EEF1F2" Padding="11,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="深色背景不代表待清除区域" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /><TextBlock Text="缺陷与保护掩膜" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border><ScrollViewer x:Name="MaskScroll" Grid.Row="1" Margin="20" Background="#D6DCDE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><Border x:Name="MaskImageFrame" BorderBrush="#40484B" BorderThickness="1"><Image Source="{Binding SelectedMaskPreview}" Stretch="Fill" /></Border></ScrollViewer></Grid>
                    <TextBlock Text="请选择图片" FontSize="16" Foreground="#788388" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <TabControl BorderThickness="0" Background="White">
                    <TabItem Header="处理设置" Style="{StaticResource SettingsTabStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="176" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="15,12"><StackPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="单位：mm" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="四边候选范围" Style="{StaticResource SectionHeaderTextStyle}" /></DockPanel>
                                <UniformGrid Columns="2" Rows="2">
                                    <Border BorderBrush="#8EBEB7" BorderThickness="1" Background="#F0F7F6" CornerRadius="4" Margin="0,0,4,4" Padding="8,5"><DockPanel><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding SelectedImage.LeftMarginMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}" ToolTip="左侧候选范围的最大深度，单位为毫米。程序只会在这条边界以内寻找缺陷，不会整块清空。范围越大，越可能遇到正文或批注；建议先用 15～20 mm，再根据红色掩膜调整。" /><CheckBox Content="左侧" IsChecked="{Binding SelectedImage.CleanLeft}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" ToolTip="开启后，程序会检查页面左边缘的装订孔、黑斑、撕裂和扫描阴影。关闭后左侧完全不参与自动清理，适合左侧经常有骑缝章或手写批注的档案。" /></DockPanel></Border>
                                                <Border BorderBrush="#8EBEB7" BorderThickness="1" Background="#F0F7F6" CornerRadius="4" Margin="4,0,0,4" Padding="8,5"><DockPanel><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding SelectedImage.RightMarginMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}" ToolTip="右侧候选范围的最大深度，单位为毫米。只应覆盖可能出现黑边、污斑或孔洞的页边区域；如果右侧有批注，请减小范围或关闭右侧检测。" /><CheckBox Content="右侧" IsChecked="{Binding SelectedImage.CleanRight}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" ToolTip="开启后检查页面右边缘。右侧未启用时，程序不会在右侧生成删除掩膜，即使检测到黑点也会原样保留。" /></DockPanel></Border>
                                    <Border BorderBrush="#8EBEB7" BorderThickness="1" Background="#F0F7F6" CornerRadius="4" Margin="0,4,4,0" Padding="8,5"><DockPanel><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding SelectedImage.TopMarginMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}" ToolTip="上侧候选范围的最大深度，单位为毫米。上边缘常有档号、页眉或印章，建议设置得比左右两侧更窄，并保持内容保护开启。" /><CheckBox Content="上侧" IsChecked="{Binding SelectedImage.CleanTop}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" ToolTip="开启后检查页面顶部的黑边、折角阴影和污点。页眉、档号和顶部批注会先进入内容保护；发生冲突时页面会转入人工确认。" /></DockPanel></Border>
                                    <Border BorderBrush="#8EBEB7" BorderThickness="1" Background="#F0F7F6" CornerRadius="4" Margin="4,4,0,0" Padding="8,5"><DockPanel><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding SelectedImage.BottomMarginMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}" ToolTip="下侧候选范围的最大深度，单位为毫米。底部通常有页码，范围过大会增加误判风险；建议保证候选边界与页码之间留有明显空隙。" /><CheckBox Content="下侧" IsChecked="{Binding SelectedImage.CleanBottom}" Style="{StaticResource SettingsCheckBoxStyle}" VerticalAlignment="Center" ToolTip="开启后检查页面底部的黑边、扫描阴影、污点和折痕。页码会受到单独保护，不会因为位于候选范围内就直接删除。" /></DockPanel></Border>
                                </UniformGrid>
                                <Button Content="应用边界到全部图片" Click="ApplyBoundaryToAll_Click" HorizontalAlignment="Right" Margin="0,10,0,0" ToolTip="将当前选中图片的四边启用状态和范围值复制到任务队列中的所有图片，并保存为下次默认边界。" />
                                <DockPanel Margin="0,8,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBoxStyle}" IsChecked="{Binding Settings.ShowCandidateGuides, Mode=TwoWay}" ToolTip="显示或隐藏四边候选范围线和拖动块；隐藏时不会影响检测范围数值。" Cursor="Hand" /><TextBlock Text="显示候选边界" VerticalAlignment="Center" /></DockPanel>
                            </StackPanel></Border>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="15,12"><StackPanel>
                                <TextBlock Text="缺陷检测" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><TextBlock Text="检测灵敏度" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.DetectionSensitivity}" Margin="8,0" ToolTip="快捷模式下同时控制浅痕、深色区域和复核门槛。展开高级检测参数后，此滑块暂停参与算法。"><Slider.Style><Style TargetType="Slider"><Setter Property="IsEnabled" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding Settings.UseAdvancedDetectionSettings}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Slider.Style></Slider><TextBlock Grid.Column="2" Text="{Binding Settings.DetectionSensitivityLabel}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                                <Expander Margin="0,8,0,2" Header="高级检测参数" IsExpanded="{Binding Settings.UseAdvancedDetectionSettings, Mode=TwoWay}">
                                    <StackPanel Margin="0,8,0,0">
                                        <UniformGrid Columns="4" Margin="0,0,0,7"><Button Tag="Conservative" Click="DetectionPreset_Click" Margin="0,0,3,0">保守</Button><Button Tag="Balanced" Click="DetectionPreset_Click" Margin="3,0">均衡</Button><Button Tag="HighRecall" Click="DetectionPreset_Click" Margin="3,0">高检出</Button><Button Click="ResetDetection_Click" Margin="3,0,0,0">默认</Button></UniformGrid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="浅痕灵敏度" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.RelativeContrastSensitivity}" Margin="8,0" ToolTip="提高后会纳入与局部纸张背景差异更小的浅污和淡阴影。" /><TextBlock Grid.Column="2" Text="{Binding Settings.RelativeContrastSensitivity, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="深色灵敏度" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.AbsoluteDarknessSensitivity}" Margin="8,0" ToolTip="提高后允许更亮的灰色区域进入缺陷候选。" /><TextBlock Grid.Column="2" Text="{Binding Settings.AbsoluteDarknessSensitivity, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><TextBlock Text="小缺陷灵敏度" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.SmallDefectSensitivity}" Margin="8,0" ToolTip="提高后减少小黑点和小孔洞的噪点过滤。" /><TextBlock Grid.Column="2" Text="{Binding Settings.SmallDefectSensitivity, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></Grid>
                                        <DockPanel Margin="0,5,0,0"><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding Settings.TraceConnectionPixels, UpdateSourceTrigger=LostFocus, StringFormat=F0}" ToolTip="以 300 DPI 为基准，连接间距较小的断续污痕和撕裂阴影。" /><TextBlock Text="断裂痕迹连接（px）" VerticalAlignment="Center" /></DockPanel>
                                        <DockPanel Margin="0,6,0,0"><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding Settings.EdgeShadowTracePixels, UpdateSourceTrigger=LostFocus, StringFormat=F0}" ToolTip="以 300 DPI 为基准，从页面最外沿向内追踪连续黑边的距离。" /><TextBlock Text="边影追踪距离（px）" VerticalAlignment="Center" /></DockPanel>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBlock Text="自动清除门槛" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="50" Maximum="95" Value="{Binding Settings.AutoRemoveConfidencePercent}" Margin="8,0" ToolTip="数值越高越保守；未达到门槛的候选进入黄色人工复核，不会自动修复。" /><TextBlock Grid.Column="2" Text="{Binding Settings.AutoRemoveConfidencePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></Grid>
                                    </StackPanel>
                                </Expander>
                                <DockPanel Margin="0,6,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBoxStyle}" IsChecked="{Binding Settings.DetectRepeatedDefects}" ToolTip="比较同一批图片中反复出现在相似位置的痕迹。重复信号只提高置信度，不会绕过内容保护。" /><TextBlock Text="批次重复痕迹" VerticalAlignment="Center" /></DockPanel>
                                <DockPanel Margin="0,8,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBoxStyle}" IsChecked="{Binding Settings.DetectPageEdgeShadow}" ToolTip="检测紧贴纸张边缘的黑线、扫描仪阴影和露出的黑色背景。" /><TextBlock Text="页面黑边与阴影" VerticalAlignment="Center" /></DockPanel>
                                <DockPanel Margin="0,8,0,0"><TextBox DockPanel.Dock="Right" Style="{StaticResource NumericSettingTextBoxStyle}" Text="{Binding Settings.MaskExpansionPixels, UpdateSourceTrigger=LostFocus, StringFormat=F0}" ToolTip="以 300 DPI 为基准，在确认的缺陷外围增加修复覆盖范围。" /><TextBlock Text="孔洞及撕裂扩展（px）" VerticalAlignment="Center" /></DockPanel>
                            </StackPanel></Border>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="15,12"><StackPanel>
                                <TextBlock Text="内容保护" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,9" />
                                <UniformGrid Columns="2" Rows="2"><CheckBox Content="印刷文字" IsChecked="{Binding Settings.ProtectPrintedText}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,3" ToolTip="保护正文、标题、档号和其他印刷文字。建议始终开启；关闭后，位于页边候选范围内的文字可能被当作黑斑处理。" /><CheckBox Content="手写批注" IsChecked="{Binding Settings.ProtectHandwriting}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,3" ToolTip="保护铅笔、钢笔等手写批注和签字。手写笔画与污渍有时非常相似，开启后程序会采用保守策略并把不确定区域标成黄色，可能增加人工复核数量。" /><CheckBox Content="印章与签名" IsChecked="{Binding Settings.ProtectStamps}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,3" ToolTip="保护红色、蓝色及黑色印章、签名和盖章文字。黑色旧印章可能与污斑相似，检测不确定时不会自动清除。" /><CheckBox Content="表格及页码" IsChecked="{Binding Settings.ProtectTablesAndPageNumbers}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,3" ToolTip="保护表格边线、页眉分隔线和页码。建议处理有制式表格或页脚编号的档案时开启，以免把靠近页面边缘的线条误认为扫描黑边。" /></UniformGrid>
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="内容保护强度" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.ContentProtectionStrength}" Margin="8,0" ToolTip="提高后会保护更淡的文字、笔迹和低饱和度印章，但靠近内容的污点更可能进入复核。" /><TextBlock Grid.Column="2" Text="{Binding Settings.ContentProtectionStrength, StringFormat={}{0:F0}}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="保护区域外扩" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding Settings.ProtectionPaddingPixels}" Margin="8,0" ToolTip="在识别出的文字、批注或印章外围再增加一圈安全距离。数值越大越不容易伤及内容，但可能留下靠近文字的污点；300 DPI 图片通常建议 6～12 px。" /><TextBlock Grid.Column="2" Text="{Binding Settings.ProtectionPaddingPixels, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                                <DockPanel Margin="0,9,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBoxStyle}" IsChecked="{Binding Settings.BlockOnConflict}" ToolTip="当缺陷区域与受保护内容重叠或距离过近时，停止自动清理并把页面标为需要确认。档案处理强烈建议保持开启，这是防止误删批注、印章和正文的最后一道保护。" /><TextBlock Text="冲突时禁止自动清理" VerticalAlignment="Center" /></DockPanel>
                            </StackPanel></Border>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="15,12"><StackPanel>
                                <TextBlock Text="背景修复与输出" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />
                                <DockPanel Margin="0,3"><ComboBox DockPanel.Dock="Right" Width="150" SelectedValue="{Binding Settings.RepairMethod}" SelectedValuePath="Content" ToolTip="选择缺陷去除后的填充方式。仿制图章修复会自动寻找相似的干净纸张纹理；污点修复会进一步校正纸张亮度和颜色并柔化接缝；快速局部修复适合小黑点；纸张纹理重建和纯色填充保留作为对照。"><ComboBoxItem Content="仿制图章修复" IsSelected="True" /><ComboBoxItem Content="污点修复" /><ComboBoxItem Content="纸张纹理重建" /><ComboBoxItem Content="快速局部修复" /><ComboBoxItem Content="纯色填充" /></ComboBox><TextBlock Text="修复方式" VerticalAlignment="Center" /></DockPanel>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="颜色羽化" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.ColorFeathering}" Margin="8,0" ToolTip="控制修复区域与原纸张之间的颜色过渡。数值低时边缘更清晰但可能看出补丁，数值高时过渡更柔和但可能轻微模糊附近纹理；通常保持“自然”即可。" /><TextBlock Grid.Column="2" Text="自然" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                                <DockPanel Margin="0,8,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBoxStyle}" IsChecked="{Binding Settings.PreserveDimensionsAndDpi}" ToolTip="保持输出图片的像素宽高和 DPI 信息与原图一致，避免档案系统中的页面尺寸、打印比例或坐标发生变化。除非有明确的重采样要求，否则建议始终开启。" /><TextBlock Text="保留原始尺寸与 DPI" VerticalAlignment="Center" /></DockPanel>
                                <DockPanel Margin="0,8,0,0"><ComboBox DockPanel.Dock="Right" Width="150" SelectedValue="{Binding Settings.OutputFormat}" SelectedValuePath="Content" ToolTip="设置结果图片格式。“与原图一致”便于保持现有档案流程；TIFF 或 PNG 可避免再次有损压缩但文件较大；JPEG 文件较小，适合原图本身就是 JPEG 的情况。"><ComboBoxItem Content="与原图一致" IsSelected="True" /><ComboBoxItem Content="TIFF" /><ComboBoxItem Content="PNG" /><ComboBoxItem Content="JPEG" /></ComboBox><TextBlock Text="输出格式" VerticalAlignment="Center" /></DockPanel>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><TextBlock Text="JPEG 质量" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="70" Maximum="100" Value="{Binding Settings.JpegQuality}" Margin="8,0" ToolTip="只在输出为 JPEG 时生效。数值越高，文字和纸张纹理保留越好，但文件更大；档案扫描件建议 92～97，不建议低于 90。" /><TextBlock Grid.Column="2" Text="{Binding Settings.JpegQuality, StringFormat={}{0:F0}}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
                            </StackPanel></Border>

                            <Border Visibility="Collapsed" Padding="15,12"><StackPanel><TextBlock Text="当前页风险" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" /><Border BorderBrush="{StaticResource ReviewBrush}" BorderThickness="3,0,0,0" Background="#FFF8E8" Padding="9,7"><TextBlock Text="{Binding RiskMessage}" Foreground="#775713" TextWrapping="Wrap" LineHeight="18" /></Border><ComboBox Margin="0,9,0,0" ItemsSource="{Binding ReviewRegions}" SelectedItem="{Binding SelectedReviewRegion}" DisplayMemberPath="DisplayText" ToolTip="选择当前页的一个黄色冲突区域。下方保留或去除按钮只作用于这里选中的区域，不会批量批准其他风险区域。" /><TextBlock Margin="0,5,0,0" Text="{Binding SelectedReviewRegionText}" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border>
                        </StackPanel></ScrollViewer>
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#FAFBFB" Padding="13,10"><Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="8" /><RowDefinition Height="34" /></Grid.RowDefinitions><Button Visibility="Collapsed" Click="KeepRegion_Click">保留该区域</Button><Button Visibility="Collapsed" Click="RemoveRegion_Click">确认去除</Button><Button Visibility="Collapsed" Click="RemoveAllReviewRegions_Click">全部确认去除</Button><Button Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshPreview_Click" ToolTip="使用当前所有设置重新生成检测掩膜和处理预览。此操作只更新屏幕预览，不会覆盖或写出源图片。">应用设置并重新预览</Button><Button Grid.Row="2" Click="RestoreAllDefaults_Click" ToolTip="恢复四边范围、检测、保护、修复和输出的全部系统默认参数，不修改图片或人工修正。">恢复默认参数</Button></Grid></Border>
                    </Grid></TabItem>
                    <TabItem Header="人工修正" Style="{StaticResource SettingsTabStyle}"><StackPanel Margin="16"><TextBlock Text="人工区域工具" Style="{StaticResource SectionHeaderTextStyle}" /><TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="选择工具后在左侧图像上拖动。保护标记优先于去除标记，修正会立即更新右侧预览。" /><UniformGrid Columns="2"><ToggleButton x:Name="ProtectBrushButton" Style="{StaticResource SegmentButtonStyle}" BorderThickness="1" Margin="0,0,4,8" Click="ProtectBrush_Click" IsEnabled="{Binding CanUseManualTools}" ToolTip="使用圆形笔刷涂画保护区域。">保护笔刷</ToggleButton><ToggleButton x:Name="RemoveBrushButton" Style="{StaticResource SegmentButtonStyle}" BorderThickness="1" Margin="4,0,0,8" Click="RemoveBrush_Click" IsEnabled="{Binding CanUseManualTools}" ToolTip="使用圆形笔刷涂画去除区域。">去除笔刷</ToggleButton><ToggleButton x:Name="CloneStampButton" Style="{StaticResource SegmentButtonStyle}" BorderThickness="1" Margin="0,0,4,0" Click="CloneStamp_Click" IsEnabled="{Binding CanUseManualTools}" ToolTip="按住 Alt 在左侧图像取样，再拖动复制样本内容。">仿制图章</ToggleButton><ToggleButton x:Name="EraserButton" Style="{StaticResource SegmentButtonStyle}" BorderThickness="1" Margin="4,0,0,0" Click="Eraser_Click" IsEnabled="{Binding CanUseManualTools}" ToolTip="恢复自动去除、已确认去除、人工去除或仿制图章覆盖区域中的原图内容；在没有去除掩膜的位置会清除人工保护标记。">恢复橡皮擦</ToggleButton></UniformGrid><DockPanel Margin="0,14,0,0"><Border DockPanel.Dock="Right" Width="24" Height="24" Background="{Binding CurrentManualToolBrush}" BorderBrush="#647178" BorderThickness="1" CornerRadius="3" /><TextBlock Text="当前工具颜色" VerticalAlignment="Center" /></DockPanel><UniformGrid Columns="6" Margin="0,7,0,0"><Button Height="26" Margin="0,0,3,0" Padding="0" Background="#29875C" BorderBrush="#526067" Tag="#29875C" Click="ToolColor_Click" ToolTip="绿色" /><Button Height="26" Margin="3,0" Padding="0" Background="#D44747" BorderBrush="#526067" Tag="#D44747" Click="ToolColor_Click" ToolTip="红色" /><Button Height="26" Margin="3,0" Padding="0" Background="#2F6FED" BorderBrush="#526067" Tag="#2F6FED" Click="ToolColor_Click" ToolTip="蓝色" /><Button Height="26" Margin="3,0" Padding="0" Background="#D59A24" BorderBrush="#526067" Tag="#D59A24" Click="ToolColor_Click" ToolTip="黄色" /><Button Height="26" Margin="3,0" Padding="0" Background="#168A9C" BorderBrush="#526067" Tag="#168A9C" Click="ToolColor_Click" ToolTip="青色" /><Button Height="26" Margin="3,0,0,0" Padding="0" Background="#59656B" BorderBrush="#526067" Tag="#59656B" Click="ToolColor_Click" ToolTip="灰色；恢复橡皮擦默认颜色" /></UniformGrid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><TextBlock Text="笔刷大小" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="10" Maximum="300" Value="{Binding BrushDiameterPixels}" Margin="8,0" ToolTip="设置圆形保护笔刷、去除笔刷和恢复橡皮擦在原图上的直径。" /><TextBlock Grid.Column="2" Text="{Binding BrushDiameterPixels, StringFormat={}{0:F0} px}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></Grid><Border Margin="0,14,0,0" Padding="10,8" Background="#F4F7F7" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding ManualToolText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /><TextBlock Margin="0,5,0,0" Text="{Binding ManualCorrectionSummary}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" /><Button Margin="0,10,0,0" Click="RestoreOriginal_Click" IsEnabled="{Binding CanRestoreOriginal}" ToolTip="恢复当前图片的原始内容，并切换为仅手工处理。">恢复成原图（仅手工处理）</Button></StackPanel></Border></StackPanel></TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#263136"><DockPanel Margin="12,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="原文件不会被覆盖" Foreground="#C6CED1" /></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#8ED2C3" /><TextBlock Text="{Binding EngineStatus}" Foreground="#C6CED1" Margin="6,0,18,0" /><TextBlock Text="OpenCV 保守规则 · ONNX 未配置时自动回退" Foreground="#8F9A9F" /></StackPanel></DockPanel></Border>
    </Grid>
</Window>

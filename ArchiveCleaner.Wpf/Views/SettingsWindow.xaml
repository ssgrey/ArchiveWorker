<Window x:Class="ArchiveCleaner.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="500" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="应用设置" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="辅助绘制快捷键" Padding="15">
                    <StackPanel>
                        <!-- 水平辅助 -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock DockPanel.Dock="Left" Text="水平辅助绘制："
                                       VerticalAlignment="Center" Width="120"/>
                            <Button DockPanel.Dock="Right" Content="清除" Width="60"
                                    Command="{Binding ClearHorizontalKeyCommand}"
                                    Margin="10,0,0,0"/>
                            <TextBox x:Name="HorizontalKeyTextBox"
                                     Text="{Binding HorizontalKeyDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     PreviewKeyDown="OnHorizontalKeyDown"
                                     GotFocus="OnHorizontalKeyBoxFocus"
                                     Background="#F5F5F5"
                                     Padding="8,5"
                                     ToolTip="点击此处后按下想要设置的按键"/>
                        </DockPanel>

                        <!-- 垂直辅助 -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock DockPanel.Dock="Left" Text="垂直辅助绘制："
                                       VerticalAlignment="Center" Width="120"/>
                            <Button DockPanel.Dock="Right" Content="清除" Width="60"
                                    Command="{Binding ClearVerticalKeyCommand}"
                                    Margin="10,0,0,0"/>
                            <TextBox x:Name="VerticalKeyTextBox"
                                     Text="{Binding VerticalKeyDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     PreviewKeyDown="OnVerticalKeyDown"
                                     GotFocus="OnVerticalKeyBoxFocus"
                                     Background="#F5F5F5"
                                     Padding="8,5"
                                     ToolTip="点击此处后按下想要设置的按键"/>
                        </DockPanel>

                        <!-- 说明文字 -->
                        <Border Background="#FFFEF5E7" Padding="10" CornerRadius="3"
                                BorderBrush="#FFE0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666">
                                    <Run Text="• 点击输入框后，按下任意键盘按键即可设置"/>
                                    <LineBreak/>
                                    <Run Text="• 按住设置的按键可在绘制时辅助水平或垂直移动"/>
                                    <LineBreak/>
                                    <Run Text="• 建议使用 Ctrl、Shift、Alt 等修饰键"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Height="32"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
            <Button Content="取消" Width="80" Height="32"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
